# ===== Server Configuration =====
PORT=3001
NODE_ENV=development

# ===== CORS =====
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Download Timeout (ms) =====
# Maximum time a download can take before timing out (default: 600000 = 10 min)
DOWNLOAD_TIMEOUT_MS=600000

# ===== Rate Limiting =====
# Max requests per window for /api/info
RATE_LIMIT_INFO_MAX=30
# Max requests per window for /api/download
RATE_LIMIT_DOWNLOAD_MAX=10
# Window duration in minutes
RATE_LIMIT_WINDOW_MIN=15

# ===== Proxy (Optional) =====
# Proxy URL for yt-dlp to avoid IP rate-limiting
# PROXY_URL=socks5://user:pass@host:port

# ===== yt-dlp Configuration =====
# Path to yt-dlp binary (defaults to 'yt-dlp' in PATH)
# YTDLP_PATH=yt-dlp
# Path to ffmpeg binary (defaults to 'ffmpeg' in PATH)
# FFMPEG_PATH=ffmpeg

# ===== Cookies (Optional) =====
# Path to Netscape-format cookies file for authenticated downloads
# COOKIES_FILE=./cookies.txt
